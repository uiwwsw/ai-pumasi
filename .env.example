# Set the keys for the providers you use. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Local Ollama model name (default qwen3). Ollama needs no key.
OLLAMA_MODEL=
# OpenAI-compatible server for extra models (for example OpenRouter, NVIDIA or a gateway on this machine). The URL must be https or a local address.
AURORA_OPENAI_COMPAT_URL=
AURORA_OPENAI_COMPAT_KEY=

# Set the keys for the providers you use. Never commit real keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Local Ollama model name (default qwen3). Ollama needs no key.
OLLAMA_MODEL=
# OpenAI-compatible server for free models (for example local a local gateway). Leave URL empty for http://127.0.0.1:8080/v1/chat/completions.
AURORA_OPENAI_COMPAT_URL=
AURORA_OPENAI_COMPAT_KEY=
